# Copy to .env.local (never commit .env.local). Run `npm run check:env` to validate.

# Signs the session cookie. SERVER ONLY — never prefix with NEXT_PUBLIC_.
# Use a different value for development, preview and production (>= 16 characters).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# Comma-separated phone numbers that get the staff role (kitchen + dashboard). SERVER ONLY.
STAFF_PHONES=0922000000

# The public origin of the site. Baked in at BUILD time, so changing it needs a redeploy.
# Development: http://localhost:3000 · Preview: the preview URL · Production: the live domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only when serving a production build over plain http on a LAN: COOKIE_SECURE=false
